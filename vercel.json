{
  "redirects": [
    {
      "source": "/p/apocalipsis-verso-verso.html",
      "destination": "/leer/revelacion/1",
      "permanent": true
    },
    {
      "source": "/p/apocalipsis-verso-verso",
      "destination": "/leer/revelacion/1",
      "permanent": true
    },
    {
      "source": "/estudios/archivo",
      "destination": "/estudios",
      "permanent": true
    },
    {
      "source": "/p/archivo.html",
      "destination": "/estudios",
      "permanent": true
    },
    {
      "source": "/p/archivo",
      "destination": "/estudios",
      "permanent": true
    },
    {
      "source": "/p/:slug.html",
      "destination": "/estudios/:slug",
      "permanent": true
    },
    {
      "source": "/p/:slug",
      "destination": "/estudios/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/leer/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/en/leer/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/estudios/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}